# Cache policy for Cloudflare Pages / Netlify.
#
# At a million visitors a day the difference between "cached at the edge" and "revalidated
# every time" is the difference between a free static site and an origin that falls over.
# The rules below are ordered from most specific to least.

# Vite fingerprints these filenames, so a changed file is always a new URL. They can be
# cached permanently and never revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are content-addressed by the same build and never mutate in place.
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Per-symbol history. Rewritten once per trading day, so a few hours of edge cache is
# safe and keeps a popular stock from generating a million origin reads.
/data/charts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The board itself. Same daily cadence, but revalidate sooner so a fresh session shows up
# promptly after the evening rebuild.
/data/*
  Cache-Control: public, max-age=900, stale-while-revalidate=86400

# The HTML shell must never be cached hard, or visitors keep booting an old bundle that
# points at asset filenames the new deploy no longer has.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
